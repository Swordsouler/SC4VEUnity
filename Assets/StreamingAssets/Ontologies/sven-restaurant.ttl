@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix geof: <http://www.opengis.net/def/function/geosparql/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sven: <https://sven.lisn.upsaclay.fr/ontology#> .
@prefix ve: <https://sven.lisn.upsaclay.fr/ve/> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@base <https://sven.lisn.upsaclay.fr/ontology> .

<https://sven.lisn.upsaclay.fr/ontology> rdf:type owl:Ontology ;
                                         dcterms:license <https://opensource.org/licenses/MIT> .

#################################################################
#    Vocabulaire du mini-jeu de service (Assets/Demonstration)
#
#    Étend sven-fruits.ttl : Food > Fruit {Apple, Banana}
#                                 > Vegetable {Carrot, Pumpkin}
#
#    Conventions (identiques à sven-fruits.ttl, à respecter) :
#      - une classe feuille est DÉFINIE par une restriction sur sven:component ;
#        c'est ce qui permet de la reconnaître à partir du composant Unity ;
#      - une classe de branche est un simple rdfs:subClassOf ;
#      - tout XComponent est sous-classe de sven:AnnotationComponent ;
#      - labels @fr ET @en obligatoires : le filtre de sélection compare
#        `?componentType rdfs:label "<mot>"@<locale>`, donc un label manquant
#        rend la classe introuvable à la voix.
#
#    Les états (Sliced, Cooked) sont des annotations ORTHOGONALES au type :
#    un objet porte « sven:Beef » ET « sven:Cooked ». Il n'existe donc AUCUNE
#    classe croisée du genre « CookedBeef » — « le bœuf cuit » est la conjonction
#    de deux filtres d'annotation, pas une classe. Ne pas en ajouter.
#################################################################


#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/license
dcterms:license rdf:type owl:AnnotationProperty .

###  https://sven.lisn.upsaclay.fr/ontology#requires
sven:requires rdf:type owl:AnnotationProperty ;
              rdfs:comment "Relates a recipe to one of its ingredient requirements."@en ,
                           "Relie une recette à l'une de ses exigences d'ingrédient."@fr ;
              rdfs:label "requires"@en ,
                         "exige"@fr .

###  https://sven.lisn.upsaclay.fr/ontology#ingredient
sven:ingredient rdf:type owl:AnnotationProperty ;
                rdfs:comment "The food class required by a recipe requirement."@en ,
                             "La classe d'aliment exigée par une exigence de recette."@fr ;
                rdfs:label "ingredient"@en ,
                           "ingrédient"@fr .

###  https://sven.lisn.upsaclay.fr/ontology#state
sven:state rdf:type owl:AnnotationProperty ;
           rdfs:comment "A state the ingredient must be in. Absent means raw and whole."@en ,
                        "Un état dans lequel l'ingrédient doit être. Absent signifie cru et entier."@fr ;
           rdfs:label "state"@en ,
                      "état"@fr .

###  https://sven.lisn.upsaclay.fr/ontology#forbidsState
sven:forbidsState rdf:type owl:AnnotationProperty ;
                  rdfs:comment "A state the ingredient must NOT be in — used by raw-only recipes."@en ,
                               "Un état dans lequel l'ingrédient ne doit PAS être — pour les recettes crues."@fr ;
                  rdfs:label "forbids state"@en ,
                             "interdit l'état"@fr .


#################################################################
#    Object Properties
#################################################################

###  https://sven.lisn.upsaclay.fr/ontology#content
sven:content rdf:type owl:ObjectProperty ;
             rdfs:comment "Relates a container to an object it holds. Emitted at runtime by the Container component, one triple per held object."@en ,
                          "Relie un contenant à un objet qu'il contient. Émis à l'exécution par le composant Container, un triplet par objet contenu."@fr ;
             rdfs:label "content"@en ,
                        "contenu"@fr .


#################################################################
#    Ingrédients — branches
#################################################################

###  https://sven.lisn.upsaclay.fr/ontology#MeatComponent
sven:MeatComponent rdf:type owl:Class ;
                   rdfs:subClassOf sven:FoodComponent, sven:AnnotationComponent ;
                   rdfs:comment "A meat component."@en ,
                                "Un composant de viande."@fr ;
                   rdfs:label "Meat"@en ,
                              "Viande"@fr .

###  https://sven.lisn.upsaclay.fr/ontology#Meat
sven:Meat rdf:type owl:Class ;
          rdfs:subClassOf sven:Food ;
          rdfs:comment "Meat."@en ,
                       "De la viande."@fr ;
          rdfs:label "Meat"@en ,
                     "Viande"@fr .


###  https://sven.lisn.upsaclay.fr/ontology#FishComponent
sven:FishComponent rdf:type owl:Class ;
                   rdfs:subClassOf sven:FoodComponent, sven:AnnotationComponent ;
                   rdfs:comment "A fish component."@en ,
                                "Un composant de poisson."@fr ;
                   rdfs:label "Fish"@en ,
                              "Poisson"@fr .

###  https://sven.lisn.upsaclay.fr/ontology#Fish
sven:Fish rdf:type owl:Class ;
          rdfs:subClassOf sven:Food ;
          rdfs:comment "Fish."@en ,
                       "Du poisson."@fr ;
          rdfs:label "Fish"@en ,
                     "Poisson"@fr .


###  https://sven.lisn.upsaclay.fr/ontology#DairyComponent
sven:DairyComponent rdf:type owl:Class ;
                    rdfs:subClassOf sven:FoodComponent, sven:AnnotationComponent ;
                    rdfs:comment "A dairy component."@en ,
                                 "Un composant de produit laitier."@fr ;
                    rdfs:label "Dairy"@en ,
                               "Produit laitier"@fr .

###  https://sven.lisn.upsaclay.fr/ontology#Dairy
sven:Dairy rdf:type owl:Class ;
           rdfs:subClassOf sven:Food ;
           rdfs:comment "A dairy product."@en ,
                        "Un produit laitier."@fr ;
           rdfs:label "Dairy"@en ,
                      "Produit laitier"@fr .


###  https://sven.lisn.upsaclay.fr/ontology#BakeryComponent
sven:BakeryComponent rdf:type owl:Class ;
                     rdfs:subClassOf sven:FoodComponent, sven:AnnotationComponent ;
                     rdfs:comment "A baked good component."@en ,
                                  "Un composant de produit de boulangerie."@fr ;
                     rdfs:label "Baked good"@en ,
                                "Produit de boulangerie"@fr .

###  https://sven.lisn.upsaclay.fr/ontology#Bakery
sven:Bakery rdf:type owl:Class ;
            rdfs:subClassOf sven:Food ;
            rdfs:comment "A baked good."@en ,
                         "Un produit de boulangerie."@fr ;
            rdfs:label "Baked good"@en ,
                       "Produit de boulangerie"@fr .


#################################################################
#    Ingrédients — feuilles
#################################################################

###  https://sven.lisn.upsaclay.fr/ontology#PotatoComponent
sven:PotatoComponent rdf:type owl:Class ;
                     rdfs:subClassOf sven:VegetableComponent, sven:AnnotationComponent ;
                     rdfs:comment "A potato component."@en ,
                                  "Un composant de pomme de terre."@fr ;
                     rdfs:label "Potato"@en ,
                                "Pomme de terre"@fr .

###  https://sven.lisn.upsaclay.fr/ontology#Potato
sven:Potato rdf:type owl:Class ;
            rdfs:subClassOf sven:Vegetable ;
            owl:equivalentClass [
                rdf:type owl:Class ;
                owl:intersectionOf (
                    sven:Node
                    [ rdf:type owl:Restriction ;
                      owl:onProperty sven:component ;
                      owl:someValuesFrom sven:PotatoComponent
                    ]
                )
            ] ;
            rdfs:comment "A potato is a vegetable."@en ,
                         "Une pomme de terre est un légume."@fr ;
            rdfs:label "Potato"@en ,
                       "Pomme de terre"@fr .


###  https://sven.lisn.upsaclay.fr/ontology#LettuceComponent
sven:LettuceComponent rdf:type owl:Class ;
                      rdfs:subClassOf sven:VegetableComponent, sven:AnnotationComponent ;
                      rdfs:comment "A lettuce component."@en ,
                                   "Un composant de laitue."@fr ;
                      rdfs:label "Lettuce"@en ,
                                 "Laitue"@fr .

###  https://sven.lisn.upsaclay.fr/ontology#Lettuce
#    Label « Laitue » et non « Salade » : « salade » désignerait aussi la famille
#    de plats sven:Salad, ce qui rendrait « mets la salade dans l'assiette » ambigu.
sven:Lettuce rdf:type owl:Class ;
             rdfs:subClassOf sven:Vegetable ;
             owl:equivalentClass [
                 rdf:type owl:Class ;
                 owl:intersectionOf (
                     sven:Node
                     [ rdf:type owl:Restriction ;
                       owl:onProperty sven:component ;
                       owl:someValuesFrom sven:LettuceComponent
                     ]
                 )
             ] ;
             rdfs:comment "Lettuce is a vegetable."@en ,
                          "La laitue est un légume."@fr ;
             rdfs:label "Lettuce"@en ,
                        "Laitue"@fr .


###  https://sven.lisn.upsaclay.fr/ontology#TomatoComponent
sven:TomatoComponent rdf:type owl:Class ;
                     rdfs:subClassOf sven:VegetableComponent, sven:AnnotationComponent ;
                     rdfs:comment "A tomato component."@en ,
                                  "Un composant de tomate."@fr ;
                     rdfs:label "Tomato"@en ,
                                "Tomate"@fr .

###  https://sven.lisn.upsaclay.fr/ontology#Tomato
sven:Tomato rdf:type owl:Class ;
            rdfs:subClassOf sven:Vegetable ;
            owl:equivalentClass [
                rdf:type owl:Class ;
                owl:intersectionOf (
                    sven:Node
                    [ rdf:type owl:Restriction ;
                      owl:onProperty sven:component ;
                      owl:someValuesFrom sven:TomatoComponent
                    ]
                )
            ] ;
            rdfs:comment "A tomato is a vegetable."@en ,
                         "Une tomate est un légume."@fr ;
            rdfs:label "Tomato"@en ,
                       "Tomate"@fr .


###  https://sven.lisn.upsaclay.fr/ontology#BeefComponent
sven:BeefComponent rdf:type owl:Class ;
                   rdfs:subClassOf sven:MeatComponent, sven:AnnotationComponent ;
                   rdfs:comment "A beef component."@en ,
                                "Un composant de bœuf."@fr ;
                   rdfs:label "Beef"@en ,
                              "Bœuf"@fr .

###  https://sven.lisn.upsaclay.fr/ontology#Beef
#    Second label « Steak » : c'est le mot que le joueur emploiera le plus souvent
#    (« steak frites », « fais cuire le steak »).
sven:Beef rdf:type owl:Class ;
          rdfs:subClassOf sven:Meat ;
          owl:equivalentClass [
              rdf:type owl:Class ;
              owl:intersectionOf (
                  sven:Node
                  [ rdf:type owl:Restriction ;
                    owl:onProperty sven:component ;
                    owl:someValuesFrom sven:BeefComponent
                  ]
              )
          ] ;
          rdfs:comment "Beef is a meat."@en ,
                       "Le bœuf est une viande."@fr ;
          rdfs:label "Beef"@en ,
                     "Steak"@en ,
                     "Bœuf"@fr ,
                     "Steak"@fr .


###  https://sven.lisn.upsaclay.fr/ontology#ChickenComponent
sven:ChickenComponent rdf:type owl:Class ;
                      rdfs:subClassOf sven:MeatComponent, sven:AnnotationComponent ;
                      rdfs:comment "A chicken component."@en ,
                                   "Un composant de poulet."@fr ;
                      rdfs:label "Chicken"@en ,
                                 "Poulet"@fr .

###  https://sven.lisn.upsaclay.fr/ontology#Chicken
sven:Chicken rdf:type owl:Class ;
             rdfs:subClassOf sven:Meat ;
             owl:equivalentClass [
                 rdf:type owl:Class ;
                 owl:intersectionOf (
                     sven:Node
                     [ rdf:type owl:Restriction ;
                       owl:onProperty sven:component ;
                       owl:someValuesFrom sven:ChickenComponent
                     ]
                 )
             ] ;
             rdfs:comment "Chicken is a meat."@en ,
                          "Le poulet est une viande."@fr ;
             rdfs:label "Chicken"@en ,
                        "Poulet"@fr .


###  https://sven.lisn.upsaclay.fr/ontology#SalmonComponent
sven:SalmonComponent rdf:type owl:Class ;
                     rdfs:subClassOf sven:FishComponent, sven:AnnotationComponent ;
                     rdfs:comment "A salmon component."@en ,
                                  "Un composant de saumon."@fr ;
                     rdfs:label "Salmon"@en ,
                                "Saumon"@fr .

###  https://sven.lisn.upsaclay.fr/ontology#Salmon
sven:Salmon rdf:type owl:Class ;
            rdfs:subClassOf sven:Fish ;
            owl:equivalentClass [
                rdf:type owl:Class ;
                owl:intersectionOf (
                    sven:Node
                    [ rdf:type owl:Restriction ;
                      owl:onProperty sven:component ;
                      owl:someValuesFrom sven:SalmonComponent
                    ]
                )
            ] ;
            rdfs:comment "Salmon is a fish."@en ,
                         "Le saumon est un poisson."@fr ;
            rdfs:label "Salmon"@en ,
                       "Saumon"@fr .


###  https://sven.lisn.upsaclay.fr/ontology#CheeseComponent
sven:CheeseComponent rdf:type owl:Class ;
                     rdfs:subClassOf sven:DairyComponent, sven:AnnotationComponent ;
                     rdfs:comment "A cheese component."@en ,
                                  "Un composant de fromage."@fr ;
                     rdfs:label "Cheese"@en ,
                                "Fromage"@fr .

###  https://sven.lisn.upsaclay.fr/ontology#Cheese
sven:Cheese rdf:type owl:Class ;
            rdfs:subClassOf sven:Dairy ;
            owl:equivalentClass [
                rdf:type owl:Class ;
                owl:intersectionOf (
                    sven:Node
                    [ rdf:type owl:Restriction ;
                      owl:onProperty sven:component ;
                      owl:someValuesFrom sven:CheeseComponent
                    ]
                )
            ] ;
            rdfs:comment "Cheese is a dairy product."@en ,
                         "Le fromage est un produit laitier."@fr ;
