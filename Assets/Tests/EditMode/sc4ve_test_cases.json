{
  "name": "SC4VE annotated test set",
  "version": "1.0",
  "created": "2026-07-30",
  "description": "Jeu de cas de test annotés pour l'évaluation comparée des deux modes d'extraction d'intention de SC4VE (LLM vs règles), avec et sans pointage. Chaque cas associe une entrée (texte horodaté au mot, contexte de dialogue) à l'issue et à la commande JSON attendues.",
  "conventions": {
    "placeholders": {
      "{pointerTerm}": "nom du composant pointeur de la scène (p. ex. Pointer), substitué au chargement comme dans le prompt système"
    },
    "timestamps": "ISO 8601 ; la source d'un déplacement se résout au StartedAt du déictique, la destination au EndedAt du terme de destination",
    "expected_outcome": [
      "executed",
      "clarification",
      "no_match",
      "not_understood"
    ],
    "ablation": "les cas ablation_sensitive changent d'issue quand PointingEnabled=false ; ablation_expected décrit le comportement attendu",
    "scene": "les issues executed/no_match supposent la scène de démonstration (sven-fruits : pommes, bananes, citrouilles, carottes)"
  },
  "metrics": [
    "exactitude du type de commande",
    "rappel et précision des paramètres",
    "justesse de la résolution des références",
    "latence"
  ],
  "counts": {
    "total": 35,
    "par_langue": {
      "fr": 29,
      "en": 6
    },
    "par_catégorie": {
      "descriptif": 12,
      "déictique": 7,
      "anaphorique": 5,
      "quantifié": 5,
      "clarification": 3,
      "rejet": 2,
      "no_match": 1
    },
    "ablation_sensitive": 8
  },
